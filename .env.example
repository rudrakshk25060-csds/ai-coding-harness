# ==========================================
# AI Coding Harness Configuration
# ==========================================

# Active Model Provider: gemini | deepseek | qwen
MODEL_PROVIDER=gemini

# Evaluator Generic API Key (acts as fallback if provider-specific key is not set)
AI_API_KEY=your_ai_api_key_here

# --- Google Gemini Configuration ---
# Get free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- DeepSeek Configuration (OpenAI-compatible) ---
# Get key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Qwen Configuration (OpenAI-compatible endpoint) ---
# Compatible with Alibaba DashScope or any evaluator endpoint
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
